rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubtitleStyle(style) {
      return style is map
        && style.keys().hasAll(['fontSize', 'textColor', 'backgroundEnabled', 'backgroundOpacity', 'dynamicMode'])
        && style.keys().hasOnly(['fontSize', 'textColor', 'backgroundEnabled', 'backgroundOpacity', 'dynamicMode'])
        && style.fontSize in ['sm', 'md', 'lg', 'xl']
        && style.textColor is string && style.textColor.size() >= 4 && style.textColor.size() <= 16
        && style.backgroundEnabled is bool
        && style.backgroundOpacity is number && style.backgroundOpacity >= 0 && style.backgroundOpacity <= 1
        && style.dynamicMode in ['classic', 'word-popup', 'karaoke'];
    }

    function isValidSegmentSample(seg) {
      return seg is map
        && seg.keys().hasAll(['id', 'startTime', 'endTime', 'originalText', 'translatedText'])
        && seg.keys().hasOnly(['id', 'startTime', 'endTime', 'originalText', 'translatedText', 'words'])
        && seg.id is number
        && seg.startTime is string && seg.startTime.size() <= 32
        && seg.endTime is string && seg.endTime.size() <= 32
        && seg.originalText is string && seg.originalText.size() <= 2000
        && seg.translatedText is string && seg.translatedText.size() <= 2000
        && (!('words' in seg) || (seg.words is list && seg.words.size() <= 500));
    }

    function isValidDubbingProject(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'sourceLanguage', 'targetLanguage',
          'voiceStyle', 'durationSeconds', 'subtitleStyle', 'segments',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'sourceLanguage', 'targetLanguage',
          'voiceStyle', 'durationSeconds', 'subtitleStyle', 'segments',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 180
        && data.sourceLanguage is string && data.sourceLanguage.size() >= 2 && data.sourceLanguage.size() <= 16
        && data.targetLanguage is string && data.targetLanguage.size() >= 2 && data.targetLanguage.size() <= 16
        && data.voiceStyle in ['male_pro', 'female_friendly', 'narrator_casual']
        && data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 86400
        && isValidSubtitleStyle(data.subtitleStyle)
        && data.segments is list && data.segments.size() <= 200
        && (data.segments.size() == 0 || isValidSegmentSample(data.segments[0]))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // PII-isolated User Profiles: strictly owner-only get/create/update; never list
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);
      allow delete: if false;
    }

    // User-owned Dubbing Projects
    match /projects/{projectId} {
      allow get: if isVerifiedUser()
        && isValidId(projectId)
        && existing().ownerId == request.auth.uid;

      allow list: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(projectId)
        && isValidDubbingProject(incoming())
        && incoming().id == projectId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(projectId)
        && existing().ownerId == request.auth.uid
        && isValidDubbingProject(incoming())
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'sourceLanguage', 'targetLanguage', 'voiceStyle',
          'durationSeconds', 'subtitleStyle', 'segments', 'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(projectId)
        && existing().ownerId == request.auth.uid;
    }
  }
}
